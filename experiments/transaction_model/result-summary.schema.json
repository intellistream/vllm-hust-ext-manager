{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["schema", "implementation_sha256", "classification", "formal_real_result", "fixed_point_reached", "actions", "reachable_states", "reachable_states_sha256", "valid_edges", "valid_edges_sha256", "rejected_state_action_pairs", "maximum_shortest_trace_length", "invariants", "assumptions", "counterexamples"],
  "properties": {
    "schema": {"const": "ecpa-bounded-transaction-model/v1"},
    "implementation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "classification": {"const": "exhaustive-finite-abstract-model"},
    "formal_real_result": {"const": false},
    "fixed_point_reached": {"const": true},
    "actions": {"type": "integer", "minimum": 1},
    "reachable_states": {"type": "integer", "minimum": 1},
    "reachable_states_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "valid_edges": {"type": "integer", "minimum": 1},
    "valid_edges_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "rejected_state_action_pairs": {"type": "integer", "minimum": 1},
    "maximum_shortest_trace_length": {"type": "integer", "minimum": 1},
    "invariants": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "assumptions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "counterexamples": {"type": "array", "maxItems": 0}
  },
  "additionalProperties": false
}
