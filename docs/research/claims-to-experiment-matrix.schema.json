{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["schema", "scope", "claims", "experiments"],
  "properties": {
    "schema": {"const": "ecpa-claims-to-experiments/v1"},
    "scope": {"const": "vllm-hust-only"},
    "claims": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": ["id", "paper_hypothesis", "contribution", "statement", "falsifier", "evidence_class", "status", "experiments", "authority_sources"],
        "properties": {
          "id": {"type": "string", "pattern": "^CLM-[A-Z0-9-]+$"},
          "paper_hypothesis": {"enum": ["H1", "H2", "H3", "H4"]},
          "contribution": {"enum": ["contract-model", "transactional-runtime", "host-evidence", "bounded-cost"]},
          "statement": {"type": "string", "minLength": 1},
          "falsifier": {"type": "string", "minLength": 1},
          "evidence_class": {"enum": ["modeled-static", "formal-real"]},
          "status": {"enum": ["modeled-evaluated", "planned", "pre-admission"]},
          "experiments": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^EXP-[A-Z0-9-]+$"}},
          "authority_sources": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["independent-static-oracle", "runner", "lifecycle-source", "vllm-hust-host", "process-monitor", "workload-client"]}}
        },
        "additionalProperties": false
      }
    },
    "experiments": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": ["id", "kind", "scenarios", "arms", "repetitions", "status", "supports", "evidence_artifacts"],
        "properties": {
          "id": {"type": "string", "pattern": "^EXP-[A-Z0-9-]+$"},
          "kind": {"enum": ["modeled-static", "formal-comparison", "formal-recovery", "formal-performance"]},
          "scenarios": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "arms": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "repetitions": {"type": "integer", "minimum": 1},
          "status": {"enum": ["modeled-evaluated", "planned", "pre-admission", "admitted"]},
          "supports": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^CLM-[A-Z0-9-]+$"}},
          "evidence_artifacts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
