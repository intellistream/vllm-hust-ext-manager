{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://vllm-hust.example/spec/ecpa/0.1/attestation.schema.json",
  "title": "ECPA Attestation Statement 0.1",
  "type": "object",
  "required": ["schema", "profile", "issuer", "kid", "subject", "plan_id", "launch_id", "plugin_id", "artifact_digest", "process", "obligation", "event", "observed_at", "issued_at", "expires_at", "challenge_nonce", "evidence_digest", "critical_claims"],
  "properties": {
    "schema": {"const": "ecpa-attestation-statement/0.1"},
    "profile": {"const": "ecpa-jcs-jws-eddsa/0.1"},
    "issuer": {"type": "string", "minLength": 1},
    "kid": {"type": "string", "minLength": 1},
    "subject": {"type": "string", "minLength": 1},
    "plan_id": {"type": "string", "minLength": 1},
    "launch_id": {"type": "string", "minLength": 1},
    "plugin_id": {"type": "string", "minLength": 1},
    "artifact_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "process": {
      "type": "object",
      "required": ["host", "role", "ordinal", "start_identity", "epoch"],
      "properties": {
        "host": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "ordinal": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "start_identity": {"type": "string", "minLength": 1},
        "epoch": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
      },
      "additionalProperties": false
    },
    "obligation": {"type": "string", "minLength": 1},
    "event": {"type": "string", "minLength": 1},
    "observed_at": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "issued_at": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "expires_at": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "challenge_nonce": {"type": "string", "minLength": 1},
    "evidence_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "critical_claims": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  },
  "additionalProperties": false
}
