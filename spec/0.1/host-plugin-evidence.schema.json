{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://vllm-hust.example/spec/ecpa/0.1/host-plugin-evidence.schema.json",
  "type": "object",
  "required": ["schema", "event_id", "event", "entry_point", "process", "observed_at_ns", "plan_id", "launch_id", "plugin_id", "artifact_digest", "identity_status", "detail"],
  "properties": {
    "schema": {"const": "vllm-hust-plugin-evidence/0.1"},
    "event_id": {"type": "string", "minLength": 1},
    "event": {"enum": ["discovered", "resolved", "invoked", "failed", "skipped"]},
    "entry_point": {"type": "object", "required": ["group", "name", "value"], "properties": {"group": {"type": "string", "minLength": 1}, "name": {"type": "string", "minLength": 1}, "value": {"type": "string", "minLength": 1}}, "additionalProperties": false},
    "process": {"type": "object", "required": ["host", "role", "ordinal", "pid", "start_identity", "process_epoch"], "properties": {"host": {"type": "string", "minLength": 1}, "role": {"type": "string", "minLength": 1}, "ordinal": {"type": "integer", "minimum": 0}, "pid": {"type": "integer", "minimum": 0}, "start_identity": {"type": "string", "minLength": 1}, "process_epoch": {"type": "integer", "minimum": 0}}, "additionalProperties": false},
    "observed_at_ns": {"type": "integer", "minimum": 0},
    "plan_id": {"type": ["string", "null"]},
    "launch_id": {"type": ["string", "null"]},
    "plugin_id": {"type": "null"},
    "artifact_digest": {"type": "null"},
    "identity_status": {"type": "string", "minLength": 1},
    "detail": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
