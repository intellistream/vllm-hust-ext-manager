{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://vllm-hust.example/spec/ecpa/0.1/manifest.schema.json",
  "type": "object",
  "required": ["schema", "id", "version", "host", "capabilities", "resources", "process_obligations", "rollback", "authority"],
  "properties": {
    "schema": {"const": "ecpa-manifest/0.1-draft"},
    "id": {"$ref": "#/definitions/identifier"},
    "version": {"type": "string", "minLength": 1, "description": "Canonical PEP 440 public version; local labels are forbidden by semantic validation."},
    "host": {
      "type": "object",
      "required": ["runtime", "version"],
      "properties": {
        "runtime": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1, "description": "PEP 440 specifier set over public host versions."}
      },
      "additionalProperties": false
    },
    "capabilities": {
      "type": "object",
      "required": ["provides", "requires"],
      "properties": {
        "provides": {"type": "array", "items": {"$ref": "#/definitions/capability_provision"}},
        "requires": {"type": "array", "items": {"$ref": "#/definitions/capability_requirement"}}
      },
      "additionalProperties": false
    },
    "resources": {"type": "array", "items": {"$ref": "#/definitions/resource_claim"}},
    "process_obligations": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/process_obligation"}},
    "rollback": {
      "type": "object",
      "required": ["manager_owned", "external_operator_owned"],
      "properties": {
        "manager_owned": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "external_operator_owned": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "authority": {
      "type": "object",
      "required": ["provider", "runtime", "external"],
      "properties": {
        "provider": {"type": "array", "items": {"$ref": "#/definitions/non_runtime_authority_grant"}},
        "runtime": {"type": "array", "items": {"$ref": "#/definitions/authority_grant"}},
        "external": {"type": "array", "items": {"$ref": "#/definitions/non_runtime_authority_grant"}}
      },
      "additionalProperties": false
    },
    "deprecated": {
      "type": "object",
      "required": ["since", "replacement"],
      "properties": {"since": {"type": "string"}, "replacement": {"$ref": "#/definitions/identifier"}},
      "additionalProperties": false
    }
  },
  "definitions": {
    "identifier": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$"},
    "event": {"enum": ["loaded", "invoked", "health-observed"]},
    "capability_provision": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {"$ref": "#/definitions/identifier"},
        "version": {"type": "string", "minLength": 1, "description": "Canonical PEP 440 public version."}
      },
      "additionalProperties": false
    },
    "capability_requirement": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {"$ref": "#/definitions/identifier"},
        "version": {"type": "string", "minLength": 1, "description": "PEP 440 specifier set over public capability versions."}
      },
      "additionalProperties": false
    },
    "resource_claim": {
      "type": "object",
      "required": ["name", "mode"],
      "properties": {
        "name": {"$ref": "#/definitions/identifier"},
        "mode": {"enum": ["exclusive", "shared-read", "mediated"]},
        "mediator": {"type": ["string", "null"]}
      },
      "allOf": [
        {
          "if": {"properties": {"mode": {"const": "mediated"}}},
          "then": {"required": ["mediator"], "properties": {"mediator": {"$ref": "#/definitions/identifier"}}},
          "else": {"properties": {"mediator": {"type": "null"}}}
        }
      ],
      "additionalProperties": false
    },
    "process_obligation": {
      "type": "object",
      "required": ["role", "event", "completion", "authority", "capability_direction", "capability"],
      "properties": {
        "role": {"type": "string", "minLength": 1},
        "event": {"$ref": "#/definitions/event"},
        "completion": {"enum": ["all", "quorum", "optional"]},
        "authority": {"enum": ["provider", "runtime", "external"]},
        "capability_direction": {"enum": ["provides", "requires"]},
        "capability": {"$ref": "#/definitions/identifier"},
        "quorum": {"type": "integer", "minimum": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"completion": {"const": "quorum"}}},
          "then": {"required": ["quorum"]},
          "else": {"not": {"required": ["quorum"]}}
        },
        {
          "if": {"properties": {"event": {"enum": ["loaded", "invoked"]}}},
          "then": {"properties": {"authority": {"const": "runtime"}}}
        }
      ],
      "additionalProperties": false
    },
    "authority_grant": {
      "type": "object",
      "required": ["role", "event", "capability_direction", "capability"],
      "properties": {
        "role": {"type": "string", "minLength": 1},
        "event": {"$ref": "#/definitions/event"},
        "capability_direction": {"enum": ["provides", "requires"]},
        "capability": {"$ref": "#/definitions/identifier"}
      },
      "additionalProperties": false
    },
    "non_runtime_authority_grant": {
      "allOf": [
        {"$ref": "#/definitions/authority_grant"},
        {"properties": {"event": {"const": "health-observed"}}}
      ]
    }
  },
  "additionalProperties": false
}
