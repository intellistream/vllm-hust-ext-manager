{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://vllm-hust.example/experiments/contract-planner/decision.schema.json",
  "type": "object",
  "required": ["case_id", "dimension", "members", "expected_decision", "expected_error", "observed_decision", "observed_error", "decision_match", "error_match", "plan_id"],
  "properties": {
    "case_id": {"type": "string"},
    "dimension": {"type": "string"},
    "members": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "expected_decision": {"enum": ["admit", "reject"]},
    "expected_error": {"type": ["string", "null"]},
    "observed_decision": {"enum": ["admit", "reject"]},
    "observed_error": {"type": ["string", "null"]},
    "decision_match": {"type": "boolean"},
    "error_match": {"type": "boolean"},
    "plan_id": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
