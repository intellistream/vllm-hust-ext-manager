{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://vllm-hust.example/spec/ecpa/0.1/manifest.schema.json",
  "type": "object",
  "required": ["schema", "id", "version", "host", "capabilities", "resources", "process_obligations", "rollback", "authority"],
  "properties": {
    "schema": {"const": "ecpa-manifest/0.1-draft"},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$"},
    "version": {"type": "string", "minLength": 1},
    "host": {"type": "object", "required": ["runtime", "version"], "properties": {"runtime": {"type": "string"}, "version": {"type": "string"}}, "additionalProperties": false},
    "capabilities": {"type": "object", "required": ["provides", "requires"], "properties": {"provides": {"type": "array", "items": {"$ref": "#/definitions/capability"}}, "requires": {"type": "array", "items": {"$ref": "#/definitions/capability"}}}, "additionalProperties": false},
    "resources": {"type": "array", "items": {"type": "object", "required": ["name", "mode"], "properties": {"name": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$"}, "mode": {"enum": ["exclusive", "shared-read", "mediated"]}, "mediator": {"type": ["string", "null"]}}, "additionalProperties": false}},
    "process_obligations": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["role", "event", "completion"], "properties": {"role": {"type": "string"}, "event": {"enum": ["loaded", "invoked", "health-observed"]}, "completion": {"enum": ["all", "quorum", "optional"]}}, "additionalProperties": false}},
    "rollback": {"type": "object", "required": ["manager_owned", "external_operator_owned"], "properties": {"manager_owned": {"type": "array", "items": {"type": "string"}}, "external_operator_owned": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false},
    "authority": {"type": "object", "required": ["provider", "runtime", "external"], "properties": {"provider": {"type": "array", "items": {"type": "string"}}, "runtime": {"type": "array", "items": {"type": "string"}}, "external": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false},
    "deprecated": {"type": "object", "required": ["since", "replacement"], "properties": {"since": {"type": "string"}, "replacement": {"type": "string"}}, "additionalProperties": false}
  },
  "definitions": {"capability": {"type": "object", "required": ["name", "version"], "properties": {"name": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$"}, "version": {"type": "string"}}, "additionalProperties": false}},
  "additionalProperties": false
}
